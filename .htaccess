# Oeuvre static site (Hostinger / LiteSpeed)
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# /api/talk (what the figure calls) -> api/talk.php; keep repo-only folders and notes off the web
<IfModule mod_rewrite.c>
  RewriteEngine On
  # one canonical host: www -> apex, https enforced by the host
  RewriteCond %{HTTP_HOST} ^www\.oeuvre\.co\.nz$ [NC]
  RewriteRule ^(.*)$ https://oeuvre.co.nz/$1 [R=301,L]
  RewriteRule ^api/talk/?$ api/talk.php [L]
  RewriteRule ^api/tts/?$ api/tts.php [L]
  RewriteRule ^(tools|docs|proto|content)(/|$) - [R=404,L]
  RewriteRule (^|/)README\.md$ - [R=404,L]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|svg|webp|bin|woff2|mp4|mp3)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # pages: browsers check back on every visit (a cheap 304 via ETag), so a release shows at once
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^llms\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
  Header set Strict-Transport-Security "max-age=31536000"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
